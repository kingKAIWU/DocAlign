{
  "$defs": {
    "AppliedPresetEvidence": {
      "additionalProperties": false,
      "properties": {
        "preset_id": {
          "title": "Preset Id",
          "type": "string"
        },
        "preset_name": {
          "title": "Preset Name",
          "type": "string"
        },
        "pack_version": {
          "title": "Pack Version",
          "type": "string"
        },
        "claim_level": {
          "$ref": "#/$defs/RulePackClaimLevel"
        },
        "scope_label": {
          "title": "Scope Label",
          "type": "string"
        },
        "maintained_by": {
          "title": "Maintained By",
          "type": "string"
        },
        "last_reviewed_on": {
          "format": "date",
          "title": "Last Reviewed On",
          "type": "string"
        },
        "source_references": {
          "items": {
            "$ref": "#/$defs/RulePackReference"
          },
          "title": "Source References",
          "type": "array"
        },
        "catalog_spec_sha256": {
          "title": "Catalog Spec Sha256",
          "type": "string"
        },
        "matches_catalog_spec": {
          "title": "Matches Catalog Spec",
          "type": "boolean"
        },
        "automated_requirements": {
          "items": {
            "$ref": "#/$defs/RulePackCoverageItem"
          },
          "title": "Automated Requirements",
          "type": "array"
        },
        "review_requirements": {
          "items": {
            "$ref": "#/$defs/RulePackCoverageItem"
          },
          "title": "Review Requirements",
          "type": "array"
        },
        "acceptance_fixture_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptance Fixture Id"
        },
        "acceptance_last_passed_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptance Last Passed On"
        },
        "acceptance_automated_checks": {
          "items": {
            "type": "string"
          },
          "title": "Acceptance Automated Checks",
          "type": "array"
        },
        "acceptance_manual_checks": {
          "items": {
            "type": "string"
          },
          "title": "Acceptance Manual Checks",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "preset_id",
        "preset_name",
        "pack_version",
        "claim_level",
        "scope_label",
        "maintained_by",
        "last_reviewed_on",
        "catalog_spec_sha256",
        "matches_catalog_spec"
      ],
      "title": "AppliedPresetEvidence",
      "type": "object"
    },
    "AuditExecutionEvidence": {
      "additionalProperties": false,
      "properties": {
        "engine_version": {
          "title": "Engine Version",
          "type": "string"
        },
        "spec_sha256": {
          "title": "Spec Sha256",
          "type": "string"
        },
        "applied_preset": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppliedPresetEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "engine_version",
        "spec_sha256"
      ],
      "title": "AuditExecutionEvidence",
      "type": "object"
    },
    "AuditSummary": {
      "additionalProperties": false,
      "properties": {
        "paragraphs": {
          "title": "Paragraphs",
          "type": "integer"
        },
        "tables": {
          "title": "Tables",
          "type": "integer"
        },
        "images": {
          "title": "Images",
          "type": "integer"
        },
        "classified_blocks": {
          "title": "Classified Blocks",
          "type": "integer"
        },
        "unknown_blocks": {
          "title": "Unknown Blocks",
          "type": "integer"
        },
        "format_operations": {
          "title": "Format Operations",
          "type": "integer"
        },
        "changed_mutations": {
          "title": "Changed Mutations",
          "type": "integer"
        },
        "validation_failures": {
          "title": "Validation Failures",
          "type": "integer"
        },
        "paragraphs_before": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraphs Before"
        },
        "paragraphs_after": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraphs After"
        },
        "auto_layout_splits": {
          "default": 0,
          "title": "Auto Layout Splits",
          "type": "integer"
        }
      },
      "required": [
        "paragraphs",
        "tables",
        "images",
        "classified_blocks",
        "unknown_blocks",
        "format_operations",
        "changed_mutations",
        "validation_failures"
      ],
      "title": "AuditSummary",
      "type": "object"
    },
    "DocumentBoundaryItem": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "handling": {
          "$ref": "#/$defs/DocumentFeatureHandling"
        },
        "review_required": {
          "default": false,
          "title": "Review Required",
          "type": "boolean"
        },
        "locators": {
          "items": {
            "type": "string"
          },
          "title": "Locators",
          "type": "array"
        },
        "locators_truncated": {
          "default": false,
          "title": "Locators Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "count",
        "handling"
      ],
      "title": "DocumentBoundaryItem",
      "type": "object"
    },
    "DocumentFeatureHandling": {
      "enum": [
        "format_and_validate",
        "preserve_and_validate",
        "preserve_only"
      ],
      "title": "DocumentFeatureHandling",
      "type": "string"
    },
    "DocumentProcessingBoundary": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "standard",
          "enum": [
            "standard",
            "review_required"
          ],
          "title": "Status",
          "type": "string"
        },
        "detected_feature_count": {
          "default": 0,
          "minimum": 0,
          "title": "Detected Feature Count",
          "type": "integer"
        },
        "review_feature_count": {
          "default": 0,
          "minimum": 0,
          "title": "Review Feature Count",
          "type": "integer"
        },
        "acknowledgment_required": {
          "default": false,
          "title": "Acknowledgment Required",
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/DocumentBoundaryItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "title": "DocumentProcessingBoundary",
      "type": "object"
    },
    "MutationRecord": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "property_path": {
          "title": "Property Path",
          "type": "string"
        },
        "before": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "status": {
          "enum": [
            "changed",
            "already_compliant",
            "skipped",
            "warning"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "property_path",
        "status"
      ],
      "title": "MutationRecord",
      "type": "object"
    },
    "PlanWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "PlanWarning",
      "type": "object"
    },
    "RulePackClaimLevel": {
      "enum": [
        "generic",
        "reference",
        "verified"
      ],
      "title": "RulePackClaimLevel",
      "type": "string"
    },
    "RulePackCoverageItem": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RulePackCoverageStatus"
        },
        "implementation_note": {
          "title": "Implementation Note",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "requirement",
        "status",
        "implementation_note"
      ],
      "title": "RulePackCoverageItem",
      "type": "object"
    },
    "RulePackCoverageStatus": {
      "enum": [
        "automated",
        "manual_review",
        "unsupported"
      ],
      "title": "RulePackCoverageStatus",
      "type": "string"
    },
    "RulePackReference": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "RulePackReference",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "fatal",
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SpecSource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/SpecSourceType",
          "default": "structured"
        },
        "preset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preset Id"
        },
        "instruction_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruction Hash"
        },
        "compiler_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compiler Version"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "reference_filename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Filename"
        },
        "reference_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Sha256"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "title": "SpecSource",
      "type": "object"
    },
    "SpecSourceType": {
      "enum": [
        "system",
        "preset",
        "natural_language",
        "template",
        "structured",
        "merged"
      ],
      "title": "SpecSourceType",
      "type": "string"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    },
    "ValidationReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "validation-report.v1",
          "default": "validation-report.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "content_fingerprint_before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Fingerprint Before"
        },
        "content_fingerprint_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Fingerprint After"
        }
      },
      "required": [
        "valid"
      ],
      "title": "ValidationReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "audit-report.v1",
      "default": "audit-report.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "source_file": {
      "title": "Source File",
      "type": "string"
    },
    "output_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output File"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "output_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Sha256"
    },
    "summary": {
      "$ref": "#/$defs/AuditSummary"
    },
    "roles": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Roles",
      "type": "object"
    },
    "mutations": {
      "items": {
        "$ref": "#/$defs/MutationRecord"
      },
      "title": "Mutations",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/PlanWarning"
      },
      "title": "Warnings",
      "type": "array"
    },
    "validation": {
      "$ref": "#/$defs/ValidationReport"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "spec_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpecSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditExecutionEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_processing_boundary": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentProcessingBoundary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "job_id",
    "source_file",
    "source_sha256",
    "summary",
    "validation"
  ],
  "title": "AuditReport",
  "type": "object"
}
