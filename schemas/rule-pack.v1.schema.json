{
  "$defs": {
    "Alignment": {
      "enum": [
        "left",
        "center",
        "right",
        "justify"
      ],
      "title": "Alignment",
      "type": "string"
    },
    "AutoLayoutSpec": {
      "additionalProperties": false,
      "description": "Deterministic structural layout applied before role-based formatting.\n\nStructural edits are deliberately conservative: only plain body paragraphs may be split,\nand every split is followed by a fresh local role analysis and content-integrity check.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "split_body_paragraphs": {
          "default": true,
          "title": "Split Body Paragraphs",
          "type": "boolean"
        },
        "split_on_manual_breaks": {
          "default": true,
          "title": "Split On Manual Breaks",
          "type": "boolean"
        },
        "target_body_chars": {
          "default": 280,
          "maximum": 2000,
          "minimum": 80,
          "title": "Target Body Chars",
          "type": "integer"
        },
        "max_body_chars": {
          "default": 480,
          "maximum": 4000,
          "minimum": 120,
          "title": "Max Body Chars",
          "type": "integer"
        }
      },
      "title": "AutoLayoutSpec",
      "type": "object"
    },
    "DocumentFormattingSpec": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "$ref": "#/$defs/PageFormattingSpec"
        }
      },
      "title": "DocumentFormattingSpec",
      "type": "object"
    },
    "FigureFormattingSpec": {
      "additionalProperties": false,
      "properties": {
        "center_image_only_paragraphs": {
          "default": false,
          "title": "Center Image Only Paragraphs",
          "type": "boolean"
        }
      },
      "title": "FigureFormattingSpec",
      "type": "object"
    },
    "FontSpec": {
      "additionalProperties": false,
      "properties": {
        "east_asia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "East Asia"
        },
        "ascii": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ascii"
        },
        "high_ansi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High Ansi"
        },
        "complex_script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Complex Script"
        },
        "size_pt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 200,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Pt"
        },
        "bold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bold"
        },
        "italic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Italic"
        },
        "underline": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Underline"
        },
        "color_hex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Hex"
        }
      },
      "title": "FontSpec",
      "type": "object"
    },
    "ForcePolicy": {
      "additionalProperties": false,
      "properties": {
        "properties": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/FormattingProperty"
          },
          "title": "Properties"
        }
      },
      "title": "ForcePolicy",
      "type": "object"
    },
    "FormattingBehavior": {
      "additionalProperties": false,
      "properties": {
        "preserve_inline_emphasis": {
          "default": true,
          "title": "Preserve Inline Emphasis",
          "type": "boolean"
        },
        "preserve_hyperlinks": {
          "default": true,
          "title": "Preserve Hyperlinks",
          "type": "boolean"
        },
        "preserve_fields": {
          "default": true,
          "title": "Preserve Fields",
          "type": "boolean"
        },
        "preserve_equations": {
          "default": true,
          "title": "Preserve Equations",
          "type": "boolean"
        },
        "preserve_unknown_xml": {
          "default": true,
          "title": "Preserve Unknown Xml",
          "type": "boolean"
        },
        "normalize_direct_paragraph_formatting": {
          "default": true,
          "title": "Normalize Direct Paragraph Formatting",
          "type": "boolean"
        },
        "normalize_direct_run_formatting": {
          "default": true,
          "title": "Normalize Direct Run Formatting",
          "type": "boolean"
        },
        "preserve_right_aligned_signatures": {
          "default": false,
          "title": "Preserve Right Aligned Signatures",
          "type": "boolean"
        },
        "apply_to_unknown_roles": {
          "default": false,
          "title": "Apply To Unknown Roles",
          "type": "boolean"
        },
        "unknown_role_fallback": {
          "$ref": "#/$defs/SemanticRole",
          "default": "body"
        },
        "validation_passes": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "title": "Validation Passes",
          "type": "integer"
        },
        "auto_repair": {
          "default": true,
          "title": "Auto Repair",
          "type": "boolean"
        }
      },
      "title": "FormattingBehavior",
      "type": "object"
    },
    "FormattingProperty": {
      "enum": [
        "font.east_asia",
        "font.ascii",
        "font.high_ansi",
        "font.complex_script",
        "font.size_pt",
        "font.bold",
        "font.italic",
        "font.underline",
        "font.color_hex",
        "paragraph.alignment",
        "paragraph.line_spacing",
        "paragraph.space_before_pt",
        "paragraph.space_after_pt",
        "paragraph.first_line_indent_pt",
        "paragraph.left_indent_pt",
        "paragraph.right_indent_pt"
      ],
      "title": "FormattingProperty",
      "type": "string"
    },
    "FormattingSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "formatting-spec.v1",
          "default": "formatting-spec.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "document": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentFormattingSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleFormattingSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "roles": {
          "additionalProperties": {
            "$ref": "#/$defs/RoleFormattingSpec"
          },
          "propertyNames": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "object"
        },
        "tables": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableFormattingSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "figures": {
          "anyOf": [
            {
              "$ref": "#/$defs/FigureFormattingSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "headers": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeaderFooterFormattingSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
