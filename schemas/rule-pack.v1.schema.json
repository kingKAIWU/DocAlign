        "preserve_existing_landscape_sections": {
          "default": true,
          "title": "Preserve Existing Landscape Sections",
          "type": "boolean"
        },
        "force_orientation_all_sections": {
          "default": false,
          "title": "Force Orientation All Sections",
          "type": "boolean"
        }
