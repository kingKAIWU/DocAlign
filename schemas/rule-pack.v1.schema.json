        "visual_cleanup": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualCleanupSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "auto_layout": {
          "$ref": "#/$defs/AutoLayoutSpec"
        },
        "behavior": {
          "$ref": "#/$defs/FormattingBehavior"
        },
        "source": {
          "$ref": "#/$defs/SpecSource"
        }
      },
      "title": "FormattingSpec",
      "type": "object"
    },
    "HeaderFooterFormattingSpec": {
      "additionalProperties": false,
      "properties": {
        "font": {
          "anyOf": [
            {
              "$ref": "#/$defs/FontSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "paragraph": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParagraphSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "HeaderFooterFormattingSpec",
      "type": "object"
    },
    "LineSpacingMode": {
      "enum": [
        "single",
        "multiple",
        "exact",
        "at_least"
      ],
      "title": "LineSpacingMode",
      "type": "string"
    },
    "LineSpacingSpec": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/LineSpacingMode"
        },
        "value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "mode"
      ],
      "title": "LineSpacingSpec",
      "type": "object"
    },
    "Orientation": {
      "enum": [
        "portrait",
        "landscape"
      ],
      "title": "Orientation",
      "type": "string"
    },
    "PageFormattingSpec": {
