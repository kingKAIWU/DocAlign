            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Left Mm"
        },
        "margin_right_mm": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Right Mm"
        },
        "header_distance_mm": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Distance Mm"
        },
        "footer_distance_mm": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
