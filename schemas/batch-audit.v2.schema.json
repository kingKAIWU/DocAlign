{
  "$defs": {
    "BatchAuditItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BatchItemStatus"
        },
        "progress": {
          "maximum": 100,
          "minimum": 0,
          "title": "Progress",
          "type": "integer"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "analysis_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Id"
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "attempt_count": {
          "minimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "validation_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Passed"
        },
        "content_integrity_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Integrity Passed"
        },
        "changed_mutations": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed Mutations"
        },
        "output_document_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Document Url"
        },
        "audit_json_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Json Url"
        }
      },
      "required": [
        "item_id",
        "position",
        "filename",
        "status",
        "progress",
        "attempt_count",
        "retryable"
      ],
      "title": "BatchAuditItem",
      "type": "object"
    },
    "BatchAuditSummary": {
      "additionalProperties": false,
      "properties": {
        "total": {
          "minimum": 1,
          "title": "Total",
          "type": "integer"
        },
        "completed": {
          "minimum": 0,
          "title": "Completed",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "canceled": {
          "minimum": 0,
          "title": "Canceled",
          "type": "integer"
        },
        "active": {
          "minimum": 0,
          "title": "Active",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "completed",
        "failed",
        "canceled",
        "active"
      ],
      "title": "BatchAuditSummary",
      "type": "object"
    },
    "BatchItemStatus": {
      "enum": [
        "preparing",
        "queued",
        "analyzing",
        "planning",
        "formatting",
        "validating",
        "repairing",
        "canceling",
        "canceled",
        "completed",
        "failed"
      ],
      "title": "BatchItemStatus",
      "type": "string"
    },
    "BatchStatus": {
      "enum": [
        "preparing",
        "processing",
        "canceling",
        "canceled",
        "completed",
        "completed_with_errors",
        "failed"
      ],
      "title": "BatchStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "batch-audit.v2",
      "default": "batch-audit.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/BatchStatus"
    },
    "progress": {
      "maximum": 100,
      "minimum": 0,
      "title": "Progress",
      "type": "integer"
    },
    "rule_pack_id": {
      "title": "Rule Pack Id",
      "type": "string"
    },
    "rule_pack_revision": {
      "minimum": 1,
      "title": "Rule Pack Revision",
      "type": "integer"
    },
    "rule_pack_name": {
      "title": "Rule Pack Name",
      "type": "string"
    },
    "rule_pack_spec_sha256": {
      "title": "Rule Pack Spec Sha256",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/BatchAuditSummary"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/BatchAuditItem"
      },
      "title": "Items",
      "type": "array"
    },
    "output_zip_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Zip Url"
    },
    "audit_json_url": {
      "title": "Audit Json Url",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "request_id",
    "name",
    "status",
    "progress",
    "rule_pack_id",
    "rule_pack_revision",
    "rule_pack_name",
    "rule_pack_spec_sha256",
    "summary",
    "items",
    "audit_json_url",
    "created_at",
    "updated_at"
  ],
  "title": "BatchAudit",
  "type": "object"
}
