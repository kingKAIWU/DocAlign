{
  "$defs": {
    "DeliveryPackageKind": {
      "enum": [
        "job",
        "batch"
      ],
      "title": "DeliveryPackageKind",
      "type": "string"
    },
    "DeliverySignatureStatus": {
      "enum": [
        "not_signed"
      ],
      "title": "DeliverySignatureStatus",
      "type": "string"
    },
    "DeliveryVerifiedItem": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "source_filename": {
          "title": "Source Filename",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "validation_passed": {
          "title": "Validation Passed",
          "type": "boolean"
        },
        "content_integrity_passed": {
          "title": "Content Integrity Passed",
          "type": "boolean"
        },
        "structure_review_items": {
          "minimum": 0,
          "title": "Structure Review Items",
          "type": "integer"
        },
        "delivery_review_items": {
          "minimum": 0,
          "title": "Delivery Review Items",
          "type": "integer"
        },
        "source_review_features": {
          "minimum": 0,
          "title": "Source Review Features",
          "type": "integer"
        }
      },
      "required": [
        "position",
        "job_id",
        "source_filename",
        "output_sha256",
        "validation_passed",
        "content_integrity_passed",
        "structure_review_items",
        "delivery_review_items",
        "source_review_features"
      ],
      "title": "DeliveryVerifiedItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "delivery-package-verification.v1",
      "default": "delivery-package-verification.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "valid": {
      "const": true,
      "default": true,
      "title": "Valid",
      "type": "boolean"
    },
    "package_kind": {
      "$ref": "#/$defs/DeliveryPackageKind"
    },
    "package_id": {
      "title": "Package Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "application_version": {
      "title": "Application Version",
      "type": "string"
    },
    "checksum_algorithm": {
      "const": "sha256",
      "default": "sha256",
      "title": "Checksum Algorithm",
      "type": "string"
    },
    "signature_status": {
      "$ref": "#/$defs/DeliverySignatureStatus"
    },
    "payload_file_count": {
      "minimum": 1,
      "title": "Payload File Count",
      "type": "integer"
    },
    "payload_bytes": {
      "minimum": 0,
      "title": "Payload Bytes",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/DeliveryVerifiedItem"
      },
      "title": "Items",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "package_kind",
    "package_id",
    "created_at",
    "application_version",
    "signature_status",
    "payload_file_count",
    "payload_bytes",
    "items"
  ],
  "title": "DeliveryPackageVerification",
  "type": "object"
}
